{
  "manifest_version": 3,
  "name": "FileView",
  "version": "1.0.0",
  "description": "A clean, modern local file explorer Chrome extension.",
  "action": {
    "default_popup": "index.html",
    "default_title": "FileView",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "file:///*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
